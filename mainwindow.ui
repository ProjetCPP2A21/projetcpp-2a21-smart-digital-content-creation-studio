      <property name="styleSheet">
       <string notr="true">/* Le stacked widget avec un dégradé orange -&gt; blanc */
QStackedWidget {
    border: 2px solid #ffaa00;
    border-radius: 8px;
    margin-top: 20px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 transparent,
        stop:1 #ffaa00
    );
    color: black;
}

/* Les pages internes (QWidget enfants directs) doivent être transparentes */
QStackedWidget &gt; QWidget {
    background: transparent;
}

/* Boutons à l'intérieur */
QStackedWidget QPushButton {
    background: #6A0DAD;         /* Mauve */
    color: white;
    border: 1px solid #4B0082;
    border-radius: 6px;
    padding: 5px 10px;
}
QStackedWidget QPushButton:hover {
    background: #1B1B3A;         /* Bleu foncé au survol */
}
</string>
